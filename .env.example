# Telegram bot token from BotFather.
bot_token="your_telegram_bot_token"

# VK bot token.
vk_bot_token="your_vk_bot_token"

# Messenger to run: "tg" or "vk".
messenger_tag="tg"

# Google Sheets table URL.
table_url="https://docs.google.com/spreadsheets/d/your_table_id/edit"

# Google Sheets table ID.
table_id="your_google_sheet_id"

# Google Sheets URL for morning duty. May be the same spreadsheet as table_url.
morning_duty_table_url="https://docs.google.com/spreadsheets/d/your_table_id/edit"

# Telegram IDs with access to /admin. Leave empty for a local demo.
admins=[]
